{
  "name": "darkpdf",
  "displayName": "Darkpdf",
  "description": "pdf viewer for dark readers base on pdfjs and vscode-pdf.",
  "version": "0.0.5",
  "publisher": "potatoChowon9",
  "repository": {
    "type": "git",
    "url": "https://github.com/PotatoZhou/darkpdf"
  },
  "engines": {
    "vscode": "^1.63.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pdf",
    "viewer",
    "dark",
    "reader"
  ],
  "icon": "pdf-logo.png",
  "activationEvents": [
    "onCustomEditor:pdf.preview",
    "onCommand:darkpdf.toggleTheme",
    "onCommand:darkpdf.zoomIn",
    "onCommand:darkpdf.zoomOut",
    "onCommand:darkpdf.resetZoom",
    "onCommand:darkpdf.nextPage",
    "onCommand:darkpdf.previousPage",
    "onCommand:darkpdf.firstPage",
    "onCommand:darkpdf.lastPage",
    "onCommand:darkpdf.gotoPage",
    "onCommand:darkpdf.copyPageText",
    "onCommand:darkpdf.print",
    "onCommand:darkpdf.exportPageImage",
    "onCommand:darkpdf.pickTheme"
  ],
  "main": "./out/src/extension",
  "contributes": {
    "capabilities": {
      "untrustedWorkspaces": {
        "supported": true
      }
    },
    "customEditors": [
      {
        "viewType": "pdf.preview",
        "displayName": "Pdf Preview",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Dark PDF Preview",
      "properties": {
        "darkpdf.default.cursor": {
          "markdownDescription": "The default cursor tool for preview.",
          "type": "string",
          "default": "select",
          "enum": [
            "select",
            "hand"
          ]
        },
        "darkpdf.default.scale": {
          "markdownDescription": "The default zoom level for preview. Allowed values are `auto`, `page-actual`, `page-fit`, `page-width`, and 1-based scale values. (`1.0` means 100%)",
          "type": "string",
          "default": "auto",
          "pattern": "^(\\d+(?:\\.\\d+)?|auto|page-actual|page-fit|page-width)$"
        },
        "darkpdf.default.sidebar": {
          "markdownDescription": "Show the sidebar on load. The default visibility of sidebar for preview.",
          "type": "boolean",
          "default": false
        },
        "darkpdf.default.scrollMode": {
          "markdownDescription": "The default scroll mode for preview.",
          "type": "string",
          "default": "vertical",
          "enum": [
            "vertical",
            "horizontal",
            "wrapped"
          ]
        },
        "darkpdf.default.spreadMode": {
          "markdownDescription": "The default spread mode for preview.",
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "odd",
            "even"
          ]
        },
        "darkpdf.default.colorMode": {
          "markdownDescription": "Start the preview in dark mode.",
          "type": "boolean",
          "default": true
        },
        "darkpdf.default.invert": {
          "markdownDescription": "The starting darkness of the dark theme, from `0` (original colours) to `100` (fully inverted).",
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 100
        },
        "darkpdf.default.autoHideToolbar": {
          "markdownDescription": "Hide the toolbar until the mouse hovers over it.",
          "type": "boolean",
          "default": true
        },
        "darkpdf.default.theme": {
          "markdownDescription": "Starting theme preset: `dark`, `original`, `sepia`, `contrast`, `custom`, or the name of a theme from `darkpdf.themes`.",
          "type": "string",
          "default": "dark"
        },
        "darkpdf.themes": {
          "markdownDescription": "User-defined theme presets, shown in the toolbar dropdown and cycled by `Ctrl+Shift+Z`. Each item needs a `name`; tune the look with the numeric `hue`, `saturation`, `brightness`, `contrast`, `sepia`, `invert` fields and set `paperColor` for a paper tint (e.g. `#102030`). Only the fields you set are applied.",
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "markdownDescription": "Theme name shown in the dropdown."
              },
              "hue": {
                "type": "number",
                "markdownDescription": "Hue rotation in degrees (0–360), applied as `hue-rotate(Ndeg)`."
              },
              "saturation": {
                "type": "number",
                "markdownDescription": "Saturation multiplier (e.g. `1.5` for stronger colors, `0.5` to desaturate)."
              },
              "brightness": {
                "type": "number",
                "markdownDescription": "Brightness multiplier (e.g. `1.1` to brighten, `0.9` to dim)."
              },
              "contrast": {
                "type": "number",
                "markdownDescription": "Contrast multiplier (e.g. `1.25` for sharper tones, `0.8` to soften)."
              },
              "sepia": {
                "type": "number",
                "markdownDescription": "Sepia amount from 0 to 1 (e.g. `0.35` for a warm paper look)."
              },
              "invert": {
                "type": "number",
                "markdownDescription": "Inversion amount from 0 to 1 (e.g. `1` to fully invert)."
              },
              "paperColor": {
                "type": "string",
                "markdownDescription": "Paper color tint, e.g. `#102030`."
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "darkpdf.default.paperColor": {
          "markdownDescription": "Paper colour for the `custom` preset, for example `#f4ecd8`. Leave empty for no paper tint.",
          "type": "string",
          "default": ""
        },
        "darkpdf.default.customFilter": {
          "markdownDescription": "Extra CSS `filter` value for the `custom` preset, for example `sepia(0.4) contrast(1.1)`.",
          "type": "string",
          "default": ""
        },
        "darkpdf.default.keepImageColor": {
          "markdownDescription": "Keep coloured images in their original colours. Slower: pages are inverted on a separate canvas layer instead of with a CSS filter.",
          "type": "boolean",
          "default": false
        },
        "darkpdf.default.restoreState": {
          "markdownDescription": "Remember the zoom level, page and dark-mode state of every document.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "commands": [
      {
        "command": "darkpdf.toggleTheme",
        "title": "Dark PDF: Cycle Theme"
      },
      {
        "command": "darkpdf.zoomIn",
        "title": "Dark PDF: Zoom In"
      },
      {
        "command": "darkpdf.zoomOut",
        "title": "Dark PDF: Zoom Out"
      },
      {
        "command": "darkpdf.resetZoom",
        "title": "Dark PDF: Reset Zoom"
      },
      {
        "command": "darkpdf.nextPage",
        "title": "Dark PDF: Next Page"
      },
      {
        "command": "darkpdf.previousPage",
        "title": "Dark PDF: Previous Page"
      },
      {
        "command": "darkpdf.firstPage",
        "title": "Dark PDF: First Page"
      },
      {
        "command": "darkpdf.lastPage",
        "title": "Dark PDF: Last Page"
      },
      {
        "command": "darkpdf.gotoPage",
        "title": "Dark PDF: Go to Page…"
      },
      {
        "command": "darkpdf.copyPageText",
        "title": "Dark PDF: Copy Current Page Text"
      },
      {
        "command": "darkpdf.print",
        "title": "Dark PDF: Print…"
      },
      {
        "command": "darkpdf.exportPageImage",
        "title": "Dark PDF: Export Current Page as Image"
      },
      {
        "command": "darkpdf.pickTheme",
        "title": "Dark PDF: Choose Theme / Inversion…"
      }
    ],
    "keybindings": [
      {
        "command": "darkpdf.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == 'pdf.preview'"
      },
      {
        "command": "darkpdf.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == 'pdf.preview'"
      },
      {
        "command": "darkpdf.resetZoom",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeCustomEditorId == 'pdf.preview'"
      },
      {
        "command": "darkpdf.nextPage",
        "key": "alt+PageDown",
        "when": "activeCustomEditorId == 'pdf.preview'"
      },
      {
        "command": "darkpdf.previousPage",
        "key": "alt+PageUp",
        "when": "activeCustomEditorId == 'pdf.preview'"
      },
      {
        "command": "darkpdf.firstPage",
        "key": "alt+Home",
        "when": "activeCustomEditorId == 'pdf.preview'"
      },
      {
        "command": "darkpdf.lastPage",
        "key": "alt+End",
        "when": "activeCustomEditorId == 'pdf.preview'"
      },
      {
        "command": "darkpdf.gotoPage",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "activeCustomEditorId == 'pdf.preview'"
      },
      {
        "command": "darkpdf.copyPageText",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "activeCustomEditorId == 'pdf.preview'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint -c .eslintrc.json --ext .ts ./src",
    "package": "vsce package"
  },
  "dependencies": {
    "@types/vscode": "^1.46.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^12.12.21",
    "@typescript-eslint/eslint-plugin": "^2.28.0",
    "@typescript-eslint/parser": "^2.28.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-prettier": "^3.1.3",
    "mocha": "^10.1.0",
    "prettier": "^2.0.4",
    "typescript": "^3.7.3",
    "vsce": "^2.15.0",
    "vscode-dts": "^0.3.1",
    "vscode-test": "^1.3.0"
  },
  "extensionKind": [
    "ui"
  ]
}
